<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Consumers see the XML docs, which carry the constraints that matter:
         one-way, read-only, cannot break the host. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>WilliamBelle.Monitoring</PackageId>

    <!-- Pre-1.0 on purpose: the ingest contract may still change. -->
    <Version>0.1.0</Version>

    <Authors>William Belle LLC</Authors>
    <Company>William Belle LLC</Company>
    <Description>Reports what only a running process can see — runtime version, environment name, and the package versions actually deployed — to a William Belle LLC monitoring endpoint. Read-only and one-way: it exposes no endpoint, accepts no commands, collects no logs or user data, and cannot fail the host application. Requires an application id and signing key issued by William Belle LLC.</Description>
    <PackageTags>monitoring;diagnostics;aspnetcore;dependencies;drift</PackageTags>
    <PackageProjectUrl>https://williambelle.co</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/williambelle-co/williambelle-monitoring-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <Copyright>Copyright © William Belle LLC</Copyright>

    <!-- Reproducible output, so a published package can be checked against this
         source. Worth more than usual for something installed into other
         people's applications. -->
    <Deterministic>true</Deterministic>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Source Link: a debugger can step straight into this source from
         nuget.org. The whole point of publishing it is that it can be read. -->
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <!-- Snapshot collection is internal: it is an implementation detail, not
         something a host application should call. The tests still cover it. -->
    <InternalsVisibleTo Include="WilliamBelle.Monitoring.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.19" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.19" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.19" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.301">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
